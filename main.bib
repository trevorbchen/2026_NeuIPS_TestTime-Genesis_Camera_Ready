	note = {arXiv:2502.14944 [q-bio]},
	keywords = {notion, Diffusion, Guidance},
	file = {Preprint PDF:/Users/jason/Zotero/storage/EIBNKU7X/Uehara et al. - 2025 - Reward-Guided Iterative Refinement in Diffusion Models at Test-Time with Applications to Protein and.pdf:application/pdf;Snapshot:/Users/jason/Zotero/storage/ELDDEIET/2502.html:text/html},
