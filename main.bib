	keywords = {notion, ML Chemistry, Diffusion},
	file = {Full Text PDF:/Users/jason/Zotero/storage/AXDNJKGR/Lee et al. - 2025 - GenMol A Drug Discovery Generalist with Discrete Diffusion.pdf:application/pdf;Snapshot:/Users/jason/Zotero/storage/48ZYD8HZ/2501.html:text/html},
}

@misc{ueharaRewardGuidedIterativeRefinement2025,
	title = {Reward-{Guided} {Iterative} {Refinement} in {Diffusion} {Models} at {Test}-{Time} with {Applications} to {Protein} and {DNA} {Design}},
