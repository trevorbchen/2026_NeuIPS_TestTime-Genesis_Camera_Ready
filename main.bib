	file = {PDF:/Users/jason/Zotero/storage/8FZZXF8K/Bushuiev et al. - 2024 - Training on test proteins improves fitness, structure, and function prediction.pdf:application/pdf;Preprint PDF:/Users/jason/Zotero/storage/4ITGTKGL/Bushuiev et al. - 2025 - One protein is all you need.pdf:application/pdf;Snapshot:/Users/jason/Zotero/storage/NNAIH9MW/2411.html:text/html},
